diagramplay
title "제어에서 행과 큰 값까지의 참조"
box control "제어 슬롯" "`head · size`"
box catalog "카탈로그" "table ID 0" tone=blue appearance=filled
box directory "디렉터리" "`heap_root`"
box record "행 페이지" "`page_id · slot`"
box overflow "큰 값" "`head · size`" {
  text "overflow 체인"
}
control -> catalog
catalog -> directory
directory -> record "순번 → ID"
record -> overflow
