diagramplay
title "서로 다른 잠금 대상과 게시 대기"
subtitle "설계: 독립 핸들 사이의 보유 상태이며 재생 시간은 실측값이 아니다"
box writer "writer" "트랜잭션 · COW"
box writerlock "writer 잠금" "`<db>-lock`" tone=blue appearance=filled {
  text "writer가 EXCLUSIVE 보유"
}
box reader "reader" "독립 핸들 · 한 문장"
box filelock "파일 잠금" "DB 파일 · `flock`" tone=blue appearance=filled {
  text "reader가 SHARED 보유"
}
box control "제어·캐시" "잠금 안의 작업" {
  text "reader: 제어 세대 확인"
  text "변경 시 캐시 재적재"
}
writer -> writerlock "트랜잭션 동안"
reader -> filelock "한 문장"
writer -> filelock "게시 EXCLUSIVE 요청"
filelock -> control "획득 후 접근"
scene "읽기와 게시" mode=loop
  light writerlock filelock
  wait 1400ms
  writer -> filelock time=900ms
  clear filelock
  show filelock "writer EXCLUSIVE 대기"
  show filelock "reader SHARED 유지"
  wait 1400ms
  light reader filelock
  clear filelock
  show filelock "reader 종료 · SHARED 해제"
  wait 900ms
  writer -> filelock time=900ms
  clear filelock
  show filelock "writer EXCLUSIVE 보유"
  filelock -> control time=900ms
  clear control
  show control "제어 write · fsync"
  clear filelock
  show filelock "게시 완료 · 잠금 해제"
  clear writerlock
  show writerlock "트랜잭션 종료 · 해제"
  wait 900ms
  reader -> filelock time=800ms
  clear filelock
  show filelock "다음 문장 SHARED 보유"
  filelock -> control time=700ms
  clear control
  show control "reader: 제어 세대 확인"
  show control "변경 시 무효화 · 재적재"
  wait 1500ms
