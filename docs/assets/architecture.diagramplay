diagramplay
title "SQL과 선택 큐의 실행 경계"
box capi "C API" "Python · `tote_*`"
box queue "선택 큐" "`ack_queue`"
box sql "DB 실행" "`session` · `database`" tone=blue appearance=filled
box heap "행과 색인" "heap · trees"
box file "파일 게시" "`catalog_store`" {
  text "`page_file`"
}
capi -> queue "큐 호출"
capi -> sql "SQL · 트랜잭션"
queue -> sql "세션 SQL"
sql -> heap "batch"
sql -> file "루트 게시"
heap -> file "페이지 I/O"
